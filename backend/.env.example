PORT=3001
FILES_ROOT=./files

# LLM Provider Selection (ollama | openai | codex)
LLM_PROVIDER=ollama

# Ollama (local or cloud)
OLLAMA_HOST=https://api.ollama.ai
OLLAMA_MODEL=codellama
OLLAMA_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Codex / GitHub Copilot
CODEX_AUTH_TOKEN=
CODEX_MODEL=gpt-4
CODEX_API_BASE=https://api.githubcopilot.com

# Backend auth (leave empty to disable)
API_AUTH_TOKEN=
